{
  "name": "eduport-design",
  "private": true,
  "description": "Monorepo for the Eduport Design System (@eduportdesign/* packages).",
  "license": "MIT",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @eduportdesign/tokens build && pnpm --filter @eduportdesign/gallery dev",
    "storybook": "pnpm --filter @eduportdesign/tokens build && pnpm --filter @eduportdesign/storybook dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish",
    "release:github": "node scripts/publish-github-packages.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.0"
  }
}
