{
  "name": "@eduportdesign/react",
  "version": "0.1.0",
  "description": "React components for the Eduport Design System: @lit/react wrappers around @eduportdesign/web-components.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ritwik-sb/Eduport-Design.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/ritwik-sb/Eduport-Design/tree/main/packages/react#readme",
  "bugs": "https://github.com/ritwik-sb/Eduport-Design/issues",
  "keywords": [
    "react",
    "design-system",
    "eduport"
  ],
  "type": "module",
