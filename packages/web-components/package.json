{
  "name": "@eduportdesign/web-components",
  "version": "0.4.0",
  "description": "Lit web components for the Eduport Design System (<ep-button>, <ep-text-field>, …). Works in any framework.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ritwik-sb/Eduport-Design.git",
    "directory": "packages/web-components"
  },
  "homepage": "https://github.com/ritwik-sb/Eduport-Design/tree/main/packages/web-components#readme",
  "bugs": "https://github.com/ritwik-sb/Eduport-Design/issues",
  "keywords": [
    "web-components",
    "lit",
    "design-system",
    "eduport"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/index.js",
    "./dist/components/*/index.js",
    "./src/index.ts",
    "./src/components/*/index.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*/index.d.ts",
      "default": "./dist/components/*/index.js"
    },
    "./custom-elements.json": "./dist/custom-elements.json",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && cem analyze",
    "icons": "node scripts/generate-icons.mjs",
    "test": "vitest run",
    "manifest": "cem analyze"
  },
  "dependencies": {
    "@eduportdesign/tokens": "workspace:^",
    "lit": "^3.3.0"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "^0.11.0",
    "@tabler/icons": "^3.49.0",
    "@vitest/browser-playwright": "5.0.3",
    "axe-core": "4.14.0",
    "playwright": "1.64.0",
    "typescript": "^7.0.0",
    "vitest": "5.0.3"
  },
  "customElements": "dist/custom-elements.json"
}
