          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        },
        {
          "color": "#3c4a3a0f",
          "offsetX": "0px",
          "offsetY": "-2px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        }
      ]
    },
    "toned": {
      "$value": [
        {
          "color": "#3c4a3a0f",
          "offsetX": "0px",
          "offsetY": "-3px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "#3c4a3a2e",
          "offsetX": "0px",
          "offsetY": "10px",
