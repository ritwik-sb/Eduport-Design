          "spread": "-16px"
        }
      ]
    },
    "raised-hover": {
      "$value": [
        {
          "color": "#3c4a3a24",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px"
        },
        {
          "color": "#3c4a3a12",
          "offsetX": "0px",
          "offsetY": "-3px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "#3c4a3a1a",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
