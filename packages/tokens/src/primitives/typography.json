{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Onest Variable",
          "Onest",
          "Noto Sans Malayalam Variable",
          "Noto Sans Malayalam",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "Onest, self-hosted by the app (@fontsource-variable/onest): open, rounded and very readable at UI sizes, with tabular figures. It has no Malayalam, so Malayalam text falls through to Noto Sans Malayalam (@fontsource-variable/noto-sans-malayalam), which apps with Malayalam content should load too. Then the platform UI font. Onest has no italic: browsers slant it."
      },
      "mono": {
        "$value": [
          "JetBrains Mono",
          "ui-monospace",
          "SFMono-Regular",
          "Menlo",
          "Consolas",
          "monospace"
        ],
        "$description": "Code, IDs and tabular data that must align character by character."
      },
      "display": {
        "$value": [
          "Gabarito Variable",
          "Gabarito",
          "Onest Variable",
          "Onest",
          "Noto Sans Malayalam Variable",
          "Noto Sans Malayalam",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "Headings, hero titles and big numbers. Gabarito, self-hosted by the app (@fontsource-variable/gabarito): a soft, chunky geometric that gives headings the Clay character. If it isn't loaded, the stack falls through to Onest, so nothing breaks. Body text and controls stay on font.family.sans."
      }
    },
    "size": {
      "$type": "dimension",
      "100": {
        "$value": "12px"
      },
      "200": {
        "$value": "14px"
      },
      "300": {
        "$value": "16px"
      },
      "400": {
        "$value": "18px"
      },
      "500": {
        "$value": "20px"
      },
      "600": {
        "$value": "24px"
      },
      "700": {
        "$value": "28px"
      },
      "800": {
        "$value": "32px"
      },
      "900": {
        "$value": "40px"
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "medium": {
        "$value": 500
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    },
    "line-height": {
      "$type": "number",
      "tight": {
        "$value": 1.2
      },
      "snug": {
        "$value": 1.35
      },
      "normal": {
        "$value": 1.5
      }
    }
  }
}
