{
  "color": {
    "$type": "color",
    "background": {
      "default": {
        "$value": "{color.clay.100}"
      },
      "canvas": {
        "$value": "{color.clay.100}"
      },
      "subtle": {
        "$value": "{color.clay.95}"
      },
      "inverse": {
        "$value": "{color.clay.15}"
      },
      "scrim": {
        "$value": "#000000b8",
        "$description": "Backdrop behind modal dialogs."
      }
    },
    "surface": {
      "default": {
        "$value": "{color.clay.100}"
      },
      "sheet": {
        "$value": "{color.clay.95}"
      },
      "raised": {
        "$value": "{color.clay.90}",
        "$description": "Elevated cards. Two steps above the page, because shadows don't show on a dark page."
      },
      "overlay": {
        "$value": "{color.clay.90}"
      },
      "sunken": {
        "$value": "{color.clay.100}"
      },
      "muted": {
        "$value": "{color.clay.95}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.clay.15}"
      },
      "secondary": {
        "$value": "{color.clay.40}"
      },
      "disabled": {
        "$value": "{color.clay.60}"
      },
      "inverse": {
        "$value": "{color.clay.100}"
      },
      "on-color": {
        "$value": "{color.white}"
      },
      "on-primary": {
        "$value": "{color.coral.100}"
      },
      "link": {
        "$value": "{color.coral.30}"
      },
      "info": {
        "$value": "{color.blue.40}"
      },
      "success": {
        "$value": "{color.green.40}"
      },
      "warning": {
        "$value": "{color.amber.40}"
      },
      "danger": {
        "$value": "{color.red.40}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.clay.80}"
      },
      "strong": {
        "$value": "{color.clay.50}"
      },
      "focus": {
        "$value": "{color.coral.40}"
      },
      "danger": {
        "$value": "{color.red.40}"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.coral.40}"
      },
      "subtle": {
        "$value": "{color.coral.90}"
      }
    },
    "category": {
      "1": {
        "subtle": {
          "$value": "{color.blue.90}"
        },
        "bold": {
          "$value": "{color.blue.40}"
        },
        "on-bold": {
          "$value": "{color.gray.100}"
        },
        "text": {
          "$value": "{color.blue.30}"
        }
      },
      "2": {
        "subtle": {
          "$value": "{color.violet.90}"
        },
        "bold": {
          "$value": "{color.violet.40}"
        },
        "on-bold": {
          "$value": "{color.gray.100}"
        },
        "text": {
          "$value": "{color.violet.30}"
        }
      },
      "3": {
        "subtle": {
          "$value": "{color.teal.90}"
        },
        "bold": {
          "$value": "{color.teal.40}"
        },
        "on-bold": {
          "$value": "{color.gray.100}"
        },
        "text": {
          "$value": "{color.teal.30}"
        }
      },
      "4": {
        "subtle": {
          "$value": "{color.green.90}"
        },
        "bold": {
          "$value": "{color.green.40}"
        },
        "on-bold": {
          "$value": "{color.gray.100}"
        },
        "text": {
          "$value": "{color.green.30}"
        }
      },
      "5": {
        "subtle": {
          "$value": "{color.amber.90}"
        },
        "bold": {
          "$value": "{color.amber.40}"
        },
        "on-bold": {
          "$value": "{color.gray.100}"
        },
        "text": {
          "$value": "{color.amber.30}"
        }
      },
      "6": {
        "subtle": {
          "$value": "{color.pink.90}"
        },
        "bold": {
          "$value": "{color.pink.40}"
        },
        "on-bold": {
          "$value": "{color.gray.100}"
        },
        "text": {
          "$value": "{color.pink.30}"
        }
      }
    },
    "interactive": {
      "primary": {
        "default": {
          "$value": "{color.coral.40}"
        },
        "hover": {
          "$value": "{color.coral.30}",
          "$description": "Darker on hover, as in light, so the white label gains contrast instead of losing it."
        },
        "active": {
          "$value": "{color.coral.20}"
        }
      },
      "secondary": {
        "default": {
          "$value": "#ffffff00"
        },
        "hover": {
          "$value": "{color.clay.90}"
        },
        "active": {
          "$value": "{color.clay.80}"
        }
      },
      "ghost": {
        "default": {
          "$value": "#ffffff00"
        },
        "hover": {
          "$value": "{color.clay.90}"
        },
        "active": {
          "$value": "{color.clay.80}"
        }
      },
      "danger": {
        "default": {
          "$value": "{color.red.60}"
        },
        "hover": {
          "$value": "{color.red.70}"
        },
        "active": {
          "$value": "{color.red.80}"
        }
      },
      "disabled": {
        "$value": "{color.clay.90}"
      }
    },
    "feedback": {
      "info": {
        "background": {
          "$value": "{color.blue.100}"
        },
        "border": {
          "$value": "{color.blue.60}"
        }
      },
      "success": {
        "background": {
          "$value": "{color.green.100}"
        },
        "border": {
          "$value": "{color.green.60}"
        }
      },
      "warning": {
        "background": {
          "$value": "{color.amber.100}"
        },
        "border": {
          "$value": "{color.amber.60}"
        }
      },
      "danger": {
        "background": {
          "$value": "{color.red.100}"
        },
        "border": {
          "$value": "{color.red.60}"
        }
      }
    },
    "rail": {
      "background": {
        "$value": "#120e0c",
        "$description": "A dark navigation rail in both themes (ep-side-nav appearance=\"inverse\"), so the brand orange can glow on it."
      },
      "text": {
        "$value": "{color.white}"
      },
      "text-secondary": {
        "$value": "{color.clay.40}",
        "$description": "Inactive items and group headings on the rail."
      },
      "hover": {
        "$value": "#ffffff12"
      },
      "current": {
        "$value": "#ffffff1f"
      },
      "border": {
        "$value": "#ffffff1f"
      },
      "accent": {
        "$value": "{color.coral.40}",
        "$description": "The current-item marker and its glow. The exact logo orange: 5:1 or more on the rail."
      },
      "badge": {
        "$value": "{color.coral.40}",
        "$description": "Count badges on the rail. Pair with rail.on-badge."
      },
      "on-badge": {
        "$value": "{color.coral.100}"
      }
    },
    "hero": {
      "start": {
        "$value": "#2a1c30",
        "$description": "Start of the brand hero gradient (ep-page-header variant=\"hero\")."
      },
      "end": {
        "$value": "#45263a",
        "$description": "End of the hero gradient. White text stays at 4.5:1 or more on both ends."
      },
      "glow": {
        "$value": "{color.coral.40}",
        "$description": "Radial highlight in the hero's top-right corner. Keep text off it, or put the text on a chip."
      },
      "text": {
        "$value": "{color.white}"
      },
      "chip": {
        "$value": "#0000004d",
        "$description": "Translucent dark tile for stats on the hero."
      },
      "aurora-1": {
        "$value": "{color.coral.60}",
        "$description": "First drifting blob in the hero, low and to the right. Text stays on the gradient, never on the blobs."
      },
      "aurora-2": {
        "$value": "{color.violet.70}",
        "$description": "Second drifting blob in the hero, behind the stat chips."
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": [
        {
          "color": "#ffffff0d",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "#00000059",
          "offsetX": "0px",
          "offsetY": "-3px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "#00000099",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "3px",
          "spread": "0px"
        },
        {
          "color": "#000000cc",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "1px",
          "spread": "0px"
        }
      ],
      "$description": "Darker and tighter than light: a soft gray shadow disappears on a dark page, so the surface color does most of the lifting."
    },
    "overlay": {
      "$value": [
        {
          "color": "#00000099",
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "24px",
          "spread": "-4px"
        },
        {
          "color": "#000000cc",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "1px",
          "spread": "0px"
        }
      ],
      "$description": "Darker than light, with a 1px contact shadow so the overlay's edge stays crisp on a dark page."
    },
    "raised-hover": {
      "$value": [
        {
          "color": "#000000cc",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "10px",
          "spread": "0px"
        },
        {
          "color": "#000000e6",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "1px",
          "spread": "0px"
        },
        {
          "color": "#ffffff1a",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px"
        }
      ],
      "$description": "Hover state of a raised surface in dark: a brighter edge and deeper shadow, no movement."
    },
    "sheen": {
      "$value": [
        {
          "color": "#ffffff66",
          "offsetX": "0px",
          "offsetY": "1.5px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "#00000029",
          "offsetX": "0px",
          "offsetY": "-3px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        }
      ],
      "$description": "Rim light and base shade inside a solid fill (primary, danger button): the edge catches light, so the fill reads as a physical key. Add a colored drop shadow beside it."
    },
    "control": {
      "$value": [
        {
          "color": "#ffffff0f",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "#00000066",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        }
      ],
      "$description": "Resting shadow for bordered controls: secondary button, segmented control, select trigger. Pair with border.default."
    },
    "inset": {
      "$value": [
        {
          "color": "#00000066",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "inset": true
        }
      ],
      "$description": "A faint inner shadow in the top edge of text inputs, so the field reads as a recess."
    },
    "sheet": {
      "$value": "{shadow.raised}",
      "$description": "The main content sheet on background.canvas (ep-app-shell). Same as shadow.raised by default; a style can drop it when the sheet and canvas share a color."
    },
    "toned": {
      "$value": [
        {
          "color": "#00000000",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        }
      ],
      "$description": "Stat tiles on a categorical tint. Flat by default: the tint is the separation."
    }
  }
}
