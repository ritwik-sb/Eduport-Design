{
  "color": {
    "$type": "color",
    "background": {
      "default": {
        "$value": "{color.gray.100}"
      },
      "subtle": {
        "$value": "{color.gray.95}"
      },
      "inverse": {
        "$value": "{color.gray.10}"
      },
      "scrim": {
        "$value": "#000000b8",
        "$description": "Backdrop behind modal dialogs."
      }
    },
    "surface": {
      "default": {
        "$value": "{color.gray.100}"
      },
      "raised": {
        "$value": "{color.gray.90}",
        "$description": "Elevated cards. Two steps above the page, because shadows don't show on a dark page."
      },
      "overlay": {
        "$value": "{color.gray.90}"
      },
      "sunken": {
        "$value": "{color.gray.100}"
      },
      "muted": {
        "$value": "{color.gray.95}"
      }
    },
    "text": {
      "primary": {
        "$value": "{color.gray.10}"
      },
      "secondary": {
        "$value": "{color.gray.40}"
      },
      "disabled": {
        "$value": "{color.gray.60}"
      },
      "inverse": {
        "$value": "{color.gray.100}"
      },
      "on-color": {
        "$value": "{color.white}"
      },
      "on-primary": {
        "$value": "{color.gray.100}"
      },
      "link": {
        "$value": "{color.brand.40}"
      },
      "info": {
        "$value": "{color.blue.40}"
      },
      "success": {
        "$value": "{color.green.40}"
      },
      "warning": {
        "$value": "{color.amber.40}"
      },
      "danger": {
        "$value": "{color.red.40}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.gray.80}"
      },
      "strong": {
        "$value": "{color.gray.50}"
      },
      "focus": {
        "$value": "{color.brand.40}"
      },
      "danger": {
        "$value": "{color.red.40}"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.brand.50}"
      },
      "subtle": {
        "$value": "{color.brand.100}"
      }
    },
    "interactive": {
      "primary": {
        "default": {
          "$value": "{color.brand.50}"
        },
        "hover": {
          "$value": "{color.brand.40}",
          "$description": "Lighter on hover in dark, so the button gains emphasis instead of fading into the page."
        },
        "active": {
          "$value": "{color.brand.30}"
        }
      },
      "secondary": {
        "default": {
          "$value": "#ffffff00"
        },
        "hover": {
          "$value": "{color.gray.90}"
        },
        "active": {
          "$value": "{color.gray.80}"
        }
      },
      "ghost": {
        "default": {
          "$value": "#ffffff00"
        },
        "hover": {
          "$value": "{color.gray.90}"
        },
        "active": {
          "$value": "{color.gray.80}"
        }
      },
      "danger": {
        "default": {
          "$value": "{color.red.60}"
        },
        "hover": {
          "$value": "{color.red.70}"
        },
        "active": {
          "$value": "{color.red.80}"
        }
      },
      "disabled": {
        "$value": "{color.gray.90}"
      }
    },
    "feedback": {
      "info": {
        "background": {
          "$value": "{color.blue.100}"
        },
        "border": {
          "$value": "{color.blue.60}"
        }
      },
      "success": {
        "background": {
          "$value": "{color.green.100}"
        },
        "border": {
          "$value": "{color.green.60}"
        }
      },
      "warning": {
        "background": {
          "$value": "{color.amber.100}"
        },
        "border": {
          "$value": "{color.amber.60}"
        }
      },
      "danger": {
        "background": {
          "$value": "{color.red.100}"
        },
        "border": {
          "$value": "{color.red.60}"
        }
      }
    }
  }
}
