{
  "color": {
    "$type": "color",
    "background": {
      "default": {
        "$value": "{color.clay.10}"
      },
      "canvas": {
        "$value": "{color.clay.15}",
        "$description": "The page behind the content sheet and cards. A step darker than the sheet, so raised surfaces separate without borders."
      },
      "subtle": {
        "$value": "{color.clay.20}"
      },
      "inverse": {
        "$value": "{color.clay.95}"
      },
      "scrim": {
        "$value": "#28211ca3",
        "$description": "Backdrop behind modal dialogs."
      }
    },
    "surface": {
      "default": {
        "$value": "{color.clay.10}"
      },
      "sheet": {
        "$value": "{color.clay.10}",
        "$description": "The main content sheet that sits on background.canvas."
      },
      "raised": {
        "$value": "{color.white}"
      },
      "overlay": {
        "$value": "{color.white}"
      },
      "sunken": {
        "$value": "{color.clay.20}"
      },
      "muted": {
        "$value": "{color.clay.25}",
        "$description": "Tinted fill that stays visible on the page: filled cards, avatars."
      }
    },
    "text": {
      "primary": {
        "$value": "{color.clay.95}"
      },
      "secondary": {
        "$value": "{color.clay.70}"
      },
      "disabled": {
        "$value": "{color.clay.50}"
      },
      "inverse": {
        "$value": "{color.clay.10}"
      },
      "on-color": {
        "$value": "{color.white}",
        "$description": "Text and icons on the danger fill. White in both themes."
      },
      "on-primary": {
        "$value": "{color.coral.100}",
        "$description": "Text and icons on the primary (coral) fill, including checked checkboxes and switches. Dark in both themes: coral carries dark text at 4.9:1 or more on every primary state."
      },
      "link": {
        "$value": "{color.coral.70}"
      },
      "info": {
        "$value": "{color.blue.70}"
      },
      "success": {
        "$value": "{color.green.70}"
      },
      "warning": {
        "$value": "{color.amber.70}"
      },
      "danger": {
        "$value": "{color.red.70}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.clay.30}"
      },
      "strong": {
        "$value": "{color.clay.60}",
        "$description": "Meets 3:1 against backgrounds. Use for input and control boundaries."
      },
      "focus": {
        "$value": "{color.coral.60}"
      },
      "danger": {
        "$value": "{color.red.60}"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.coral.60}",
        "$description": "Non-text marks and the boundary of checked controls: progress, active tab underline, checkbox and radio edges. A deeper coral than the primary fill, so thin marks keep 3:1 on tinted backgrounds."
      },
      "subtle": {
        "$value": "{color.coral.20}",
        "$description": "Selected or highlighted rows and cards."
      }
    },
    "category": {
      "1": {
        "subtle": {
          "$value": "{color.blue.20}"
        },
        "bold": {
          "$value": "{color.blue.60}"
        },
        "on-bold": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.blue.70}"
        }
      },
      "2": {
        "subtle": {
          "$value": "{color.violet.20}"
        },
        "bold": {
          "$value": "{color.violet.60}"
        },
        "on-bold": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.violet.70}"
        }
      },
      "3": {
        "subtle": {
          "$value": "{color.teal.20}"
        },
        "bold": {
          "$value": "{color.teal.60}"
        },
        "on-bold": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.teal.70}"
        }
      },
      "4": {
        "subtle": {
          "$value": "{color.green.20}"
        },
        "bold": {
          "$value": "{color.green.60}"
        },
        "on-bold": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.green.70}"
        }
      },
      "5": {
        "subtle": {
          "$value": "{color.amber.20}"
        },
        "bold": {
          "$value": "{color.amber.60}"
        },
        "on-bold": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.amber.70}"
        }
      },
      "6": {
        "subtle": {
          "$value": "{color.pink.20}"
        },
        "bold": {
          "$value": "{color.pink.60}"
        },
        "on-bold": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.pink.70}"
        }
      }
    },
    "interactive": {
      "primary": {
        "default": {
          "$value": "{color.coral.55}",
          "$description": "Coral, deep enough to stand out 3:1 from the page while carrying dark text (text.on-primary). Hover lightens to coral.50."
        },
        "hover": {
          "$value": "{color.coral.50}"
        },
        "active": {
          "$value": "{color.coral.58}"
        }
      },
      "secondary": {
        "default": {
          "$value": "#ffffff00",
          "$description": "Secondary buttons are outlined: a border.strong edge and text.primary label on a clear fill, so they never outweigh the primary button and never read as disabled."
        },
        "hover": {
          "$value": "{color.clay.20}"
        },
        "active": {
          "$value": "{color.clay.25}"
        }
      },
      "ghost": {
        "default": {
          "$value": "#ffffff00"
        },
        "hover": {
          "$value": "{color.clay.20}"
        },
        "active": {
          "$value": "{color.clay.25}"
        }
      },
      "danger": {
        "default": {
          "$value": "{color.red.60}"
        },
        "hover": {
          "$value": "{color.red.70}"
        },
        "active": {
          "$value": "{color.red.80}"
        }
      },
      "disabled": {
        "$value": "{color.clay.20}"
      }
    },
    "feedback": {
      "info": {
        "background": {
          "$value": "{color.blue.10}"
        },
        "border": {
          "$value": "{color.blue.50}"
        }
      },
      "success": {
        "background": {
          "$value": "{color.green.10}"
        },
        "border": {
          "$value": "{color.green.50}"
        }
      },
      "warning": {
        "background": {
          "$value": "{color.amber.10}"
        },
        "border": {
          "$value": "{color.amber.50}"
        }
      },
      "danger": {
        "background": {
          "$value": "{color.red.10}"
        },
        "border": {
          "$value": "{color.red.50}"
        }
      }
    },
    "rail": {
      "background": {
        "$value": "{color.clay.95}",
        "$description": "A dark cocoa navigation rail in both themes (ep-side-nav appearance=\"inverse\"), so the coral marker glows on it."
      },
      "text": {
        "$value": "{color.white}"
      },
      "text-secondary": {
        "$value": "{color.clay.40}",
        "$description": "Inactive items and group headings on the rail."
      },
      "hover": {
        "$value": "#ffffff12"
      },
      "current": {
        "$value": "#ffffff1f"
      },
      "border": {
        "$value": "#ffffff1f"
      },
      "accent": {
        "$value": "{color.coral.50}",
        "$description": "The current-item marker and its glow: 3:1 or more on the rail."
      },
      "badge": {
        "$value": "{color.coral.50}",
        "$description": "Count badges on the rail. Pair with rail.on-badge."
      },
      "on-badge": {
        "$value": "{color.coral.100}"
      }
    },
    "hero": {
      "start": {
        "$value": "#3a2741",
        "$description": "Start of the hero gradient (ep-page-header variant=\"hero\"): a deep plum, so coral and pastel accents glow on it."
      },
      "end": {
        "$value": "#5e3347",
        "$description": "End of the hero gradient. White text stays at 4.5:1 or more on both ends."
      },
      "glow": {
        "$value": "{color.coral.50}",
        "$description": "Radial highlight in the hero's top-right corner. Keep text off it, or put the text on a chip."
      },
      "text": {
        "$value": "{color.white}"
      },
      "chip": {
        "$value": "#0000004d",
        "$description": "Translucent dark tile for stats on the hero."
      },
      "aurora-1": {
        "$value": "{color.coral.40}",
        "$description": "First drifting blob in the hero, low and to the right. Text stays on the gradient, never on the blobs."
      },
      "aurora-2": {
        "$value": "{color.violet.50}",
        "$description": "Second drifting blob in the hero, behind the stat chips."
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": [
        {
          "color": "#78503c14",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px"
        },
        {
          "color": "#78503c0f",
          "offsetX": "0px",
          "offsetY": "-3px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "#78503c12",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        },
        {
          "color": "#78503c3d",
          "offsetX": "0px",
          "offsetY": "12px",
          "blur": "24px",
          "spread": "-12px"
        }
      ],
      "$description": "Cards, tooltips and other surfaces that sit just above the page: a faint ring, a soft pressed edge along the bottom (the clay look) and a warm drop shadow, so cards need no border. Use with color.surface.raised."
    },
    "overlay": {
      "$value": [
        {
          "color": "#78503c1a",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px"
        },
        {
          "color": "#78503c14",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "6px",
          "spread": "0px"
        },
        {
          "color": "#78503c52",
          "offsetX": "0px",
          "offsetY": "24px",
          "blur": "48px",
          "spread": "-16px"
        }
      ],
      "$description": "Menus, popovers, dialogs, toasts: anything that floats over content. Use with color.surface.overlay."
    },
    "raised-hover": {
      "$value": [
        {
          "color": "#78503c24",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px"
        },
        {
          "color": "#78503c12",
          "offsetX": "0px",
          "offsetY": "-3px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "#78503c1a",
          "offsetX": "0px",
          "offsetY": "4px",
          "blur": "8px",
          "spread": "0px"
        },
        {
          "color": "#78503c52",
          "offsetX": "0px",
          "offsetY": "18px",
          "blur": "32px",
          "spread": "-12px"
        }
      ],
      "$description": "Raised surfaces that respond to the pointer (a card that is a link). Same position, a stronger ring and deeper shadow: the surface doesn't move."
    },
    "sheen": {
      "$value": [
        {
          "color": "#ffffff59",
          "offsetX": "0px",
          "offsetY": "1.5px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "#0000001f",
          "offsetX": "0px",
          "offsetY": "-3px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        }
      ],
      "$description": "Rim light along the top and a pressed edge along the bottom, inside a solid fill (primary, danger button): the fill reads as a soft clay key. Add a colored drop shadow beside it."
    },
    "control": {
      "$value": [
        {
          "color": "#78503c14",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        },
        {
          "color": "#78503c0f",
          "offsetX": "0px",
          "offsetY": "-2px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        }
      ],
      "$description": "Resting shadow for bordered controls: secondary button, segmented control, select trigger. Pair with border.default."
    },
    "inset": {
      "$value": [
        {
          "color": "#0000000d",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "inset": true
        }
      ],
      "$description": "A faint inner shadow in the top edge of text inputs, so the field reads as a recess."
    },
    "sheet": {
      "$value": "{shadow.raised}",
      "$description": "The main content sheet on background.canvas (ep-app-shell). Same as shadow.raised by default; a style can drop it when the sheet and canvas share a color."
    },
    "toned": {
      "$value": [
        {
          "color": "#78503c0f",
          "offsetX": "0px",
          "offsetY": "-3px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "#78503c33",
          "offsetX": "0px",
          "offsetY": "10px",
          "blur": "20px",
          "spread": "-12px"
        }
      ],
      "$description": "Stat tiles on a categorical tint: the same soft pressed edge and warm drop as raised surfaces, without the ring."
    }
  }
}
