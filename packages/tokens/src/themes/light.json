{
  "color": {
    "$type": "color",
    "background": {
      "default": {
        "$value": "{color.white}"
      },
      "subtle": {
        "$value": "{color.gray.10}"
      },
      "inverse": {
        "$value": "{color.gray.100}"
      },
      "scrim": {
        "$value": "#171412a3",
        "$description": "Backdrop behind modal dialogs."
      }
    },
    "surface": {
      "default": {
        "$value": "{color.white}"
      },
      "raised": {
        "$value": "{color.white}"
      },
      "overlay": {
        "$value": "{color.white}"
      },
      "sunken": {
        "$value": "{color.gray.10}"
      },
      "muted": {
        "$value": "{color.gray.20}",
        "$description": "Tinted fill that stays visible on the page: filled cards, avatars."
      }
    },
    "text": {
      "primary": {
        "$value": "{color.gray.100}"
      },
      "secondary": {
        "$value": "{color.gray.70}"
      },
      "disabled": {
        "$value": "{color.gray.50}"
      },
      "inverse": {
        "$value": "{color.white}"
      },
      "on-color": {
        "$value": "{color.white}",
        "$description": "Text and icons on the danger fill. White in both themes."
      },
      "on-primary": {
        "$value": "{color.gray.100}",
        "$description": "Text and icons on the primary (brand orange) fill, including checked checkboxes and switches. Near-black in both themes: 6.09:1 on the brand color, where white is only 3.01:1."
      },
      "link": {
        "$value": "{color.brand.70}"
      },
      "info": {
        "$value": "{color.blue.70}"
      },
      "success": {
        "$value": "{color.green.70}"
      },
      "warning": {
        "$value": "{color.amber.70}"
      },
      "danger": {
        "$value": "{color.red.70}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.gray.30}"
      },
      "strong": {
        "$value": "{color.gray.60}",
        "$description": "Meets 3:1 against backgrounds. Use for input and control boundaries."
      },
      "focus": {
        "$value": "{color.brand.60}"
      },
      "danger": {
        "$value": "{color.red.60}"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.brand.60}",
        "$description": "Non-text marks and the boundary of checked controls: progress, active tab underline, checkbox and radio edges. brand.60 in light, because the brand color itself is under 3:1 on tinted backgrounds; dark uses the exact brand orange."
      },
      "subtle": {
        "$value": "{color.brand.10}",
        "$description": "Selected or highlighted rows and cards."
      }
    },
    "interactive": {
      "primary": {
        "default": {
          "$value": "{color.brand.50}",
          "$description": "The exact brand color. Pair with text.on-primary (6.09:1)."
        },
        "hover": {
          "$value": "{color.brand.55}"
        },
        "active": {
          "$value": "{color.brand.57}"
        }
      },
      "secondary": {
        "default": {
          "$value": "#ffffff00",
          "$description": "Secondary buttons are outlined: a border.strong edge and text.primary label on a clear fill, so they never outweigh the primary button and never read as disabled."
        },
        "hover": {
          "$value": "{color.gray.20}"
        },
        "active": {
          "$value": "{color.gray.30}"
        }
      },
      "ghost": {
        "default": {
          "$value": "#ffffff00"
        },
        "hover": {
          "$value": "{color.gray.20}"
        },
        "active": {
          "$value": "{color.gray.30}"
        }
      },
      "danger": {
        "default": {
          "$value": "{color.red.60}"
        },
        "hover": {
          "$value": "{color.red.70}"
        },
        "active": {
          "$value": "{color.red.80}"
        }
      },
      "disabled": {
        "$value": "{color.gray.20}"
      }
    },
    "feedback": {
      "info": {
        "background": {
          "$value": "{color.blue.10}"
        },
        "border": {
          "$value": "{color.blue.50}"
        }
      },
      "success": {
        "background": {
          "$value": "{color.green.10}"
        },
        "border": {
          "$value": "{color.green.50}"
        }
      },
      "warning": {
        "background": {
          "$value": "{color.amber.10}"
        },
        "border": {
          "$value": "{color.amber.50}"
        }
      },
      "danger": {
        "background": {
          "$value": "{color.red.10}"
        },
        "border": {
          "$value": "{color.red.50}"
        }
      }
    }
  }
}
