{
  "color": {
    "$type": "color",
    "background": {
      "default": {
        "$value": "{color.white}"
      },
      "canvas": {
        "$value": "{color.gray.15}",
        "$description": "The page behind the content sheet and cards. A step darker than the sheet, so raised surfaces separate without borders."
      },
      "subtle": {
        "$value": "{color.gray.10}"
      },
      "inverse": {
        "$value": "{color.gray.100}"
      },
      "scrim": {
        "$value": "#0f0f0fa3",
        "$description": "Backdrop behind modal dialogs."
      }
    },
    "surface": {
      "default": {
        "$value": "{color.white}"
      },
      "sheet": {
        "$value": "{color.white}",
        "$description": "The main content sheet that sits on background.canvas."
      },
      "raised": {
        "$value": "{color.white}"
      },
      "overlay": {
        "$value": "{color.white}"
      },
      "sunken": {
        "$value": "{color.gray.10}"
      },
      "muted": {
        "$value": "{color.gray.20}",
        "$description": "Tinted fill that stays visible on the page: filled cards, avatars."
      }
    },
    "text": {
      "primary": {
        "$value": "{color.gray.100}"
      },
      "secondary": {
        "$value": "{color.gray.70}"
      },
      "disabled": {
        "$value": "{color.gray.50}"
      },
      "inverse": {
        "$value": "{color.white}"
      },
      "on-color": {
        "$value": "{color.white}",
        "$description": "Text and icons on the danger fill. White in both themes."
      },
      "on-primary": {
        "$value": "{color.white}",
        "$description": "Text and icons on the primary (brand orange) fill, including checked checkboxes and switches. White in both themes: 4.53:1 or more on every primary state."
      },
      "link": {
        "$value": "{color.brand.70}"
      },
      "info": {
        "$value": "{color.blue.70}"
      },
      "success": {
        "$value": "{color.green.70}"
      },
      "warning": {
        "$value": "{color.amber.70}"
      },
      "danger": {
        "$value": "{color.red.70}"
      }
    },
    "border": {
      "default": {
        "$value": "{color.gray.30}"
      },
      "strong": {
        "$value": "{color.gray.60}",
        "$description": "Meets 3:1 against backgrounds. Use for input and control boundaries."
      },
      "focus": {
        "$value": "{color.brand.60}"
      },
      "danger": {
        "$value": "{color.red.60}"
      }
    },
    "accent": {
      "default": {
        "$value": "{color.brand.60}",
        "$description": "Non-text marks and the boundary of checked controls: progress, active tab underline, checkbox and radio edges. brand.60 in light, because the brand color itself is under 3:1 on tinted backgrounds; dark uses the exact brand orange."
      },
      "subtle": {
        "$value": "{color.brand.10}",
        "$description": "Selected or highlighted rows and cards."
      }
    },
    "category": {
      "1": {
        "subtle": {
          "$value": "{color.blue.20}"
        },
        "bold": {
          "$value": "{color.blue.60}"
        },
        "on-bold": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.blue.70}"
        }
      },
      "2": {
        "subtle": {
          "$value": "{color.violet.20}"
        },
        "bold": {
          "$value": "{color.violet.60}"
        },
        "on-bold": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.violet.70}"
        }
      },
      "3": {
        "subtle": {
          "$value": "{color.teal.20}"
        },
        "bold": {
          "$value": "{color.teal.60}"
        },
        "on-bold": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.teal.70}"
        }
      },
      "4": {
        "subtle": {
          "$value": "{color.green.20}"
        },
        "bold": {
          "$value": "{color.green.60}"
        },
        "on-bold": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.green.70}"
        }
      },
      "5": {
        "subtle": {
          "$value": "{color.amber.20}"
        },
        "bold": {
          "$value": "{color.amber.60}"
        },
        "on-bold": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.amber.70}"
        }
      },
      "6": {
        "subtle": {
          "$value": "{color.pink.20}"
        },
        "bold": {
          "$value": "{color.pink.60}"
        },
        "on-bold": {
          "$value": "{color.white}"
        },
        "text": {
          "$value": "{color.pink.70}"
        }
      }
    },
    "interactive": {
      "primary": {
        "default": {
          "$value": "{color.brand.58}",
          "$description": "The brand orange, darkened just enough for white text (text.on-primary, 4.53:1). The exact logo orange is brand.50."
        },
        "hover": {
          "$value": "{color.brand.60}"
        },
        "active": {
          "$value": "{color.brand.70}"
        }
      },
      "secondary": {
        "default": {
          "$value": "#ffffff00",
          "$description": "Secondary buttons are outlined: a border.strong edge and text.primary label on a clear fill, so they never outweigh the primary button and never read as disabled."
        },
        "hover": {
          "$value": "{color.gray.20}"
        },
        "active": {
          "$value": "{color.gray.30}"
        }
      },
      "ghost": {
        "default": {
          "$value": "#ffffff00"
        },
        "hover": {
          "$value": "{color.gray.20}"
        },
        "active": {
          "$value": "{color.gray.30}"
        }
      },
      "danger": {
        "default": {
          "$value": "{color.red.60}"
        },
        "hover": {
          "$value": "{color.red.70}"
        },
        "active": {
          "$value": "{color.red.80}"
        }
      },
      "disabled": {
        "$value": "{color.gray.20}"
      }
    },
    "feedback": {
      "info": {
        "background": {
          "$value": "{color.blue.10}"
        },
        "border": {
          "$value": "{color.blue.50}"
        }
      },
      "success": {
        "background": {
          "$value": "{color.green.10}"
        },
        "border": {
          "$value": "{color.green.50}"
        }
      },
      "warning": {
        "background": {
          "$value": "{color.amber.10}"
        },
        "border": {
          "$value": "{color.amber.50}"
        }
      },
      "danger": {
        "background": {
          "$value": "{color.red.10}"
        },
        "border": {
          "$value": "{color.red.50}"
        }
      }
    },
    "rail": {
      "background": {
        "$value": "{color.gray.95}",
        "$description": "A dark navigation rail in both themes (ep-side-nav appearance=\"inverse\"), so the brand orange can glow on it."
      },
      "text": {
        "$value": "{color.white}"
      },
      "text-secondary": {
        "$value": "{color.gray.40}",
        "$description": "Inactive items and group headings on the rail."
      },
      "hover": {
        "$value": "#ffffff12"
      },
      "current": {
        "$value": "#ffffff1f"
      },
      "border": {
        "$value": "#ffffff1f"
      },
      "accent": {
        "$value": "{color.brand.50}",
        "$description": "The current-item marker and its glow. The exact logo orange: 5:1 or more on the rail."
      },
      "badge": {
        "$value": "{color.brand.50}",
        "$description": "Count badges on the rail. Pair with rail.on-badge."
      },
      "on-badge": {
        "$value": "{color.gray.100}"
      }
    },
    "hero": {
      "start": {
        "$value": "{color.brand.70}",
        "$description": "Start of the brand hero gradient (ep-page-header variant=\"hero\")."
      },
      "end": {
        "$value": "{color.brand.58}",
        "$description": "End of the hero gradient. White text stays at 4.5:1 or more on both ends."
      },
      "glow": {
        "$value": "{color.brand.50}",
        "$description": "Radial highlight in the hero's top-right corner. Keep text off it, or put the text on a chip."
      },
      "text": {
        "$value": "{color.white}"
      },
      "chip": {
        "$value": "#0000004d",
        "$description": "Translucent dark tile for stats on the hero."
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": [
        {
          "color": "#0000000f",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px"
        },
        {
          "color": "#0000000d",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        },
        {
          "color": "#00000014",
          "offsetX": "0px",
          "offsetY": "8px",
          "blur": "16px",
          "spread": "-8px"
        }
      ],
      "$description": "Cards, tooltips and other surfaces that sit just above the page: a 1px ring plus two soft layers, so cards need no border. Use with color.surface.raised."
    },
    "overlay": {
      "$value": "{shadow.lg}",
      "$description": "Menus, popovers, dialogs, toasts: anything that floats over content. Use with color.surface.overlay."
    },
    "raised-hover": {
      "$value": [
        {
          "color": "#00000026",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "1px"
        },
        {
          "color": "#00000012",
          "offsetX": "0px",
          "offsetY": "2px",
          "blur": "4px",
          "spread": "0px"
        },
        {
          "color": "#00000033",
          "offsetX": "0px",
          "offsetY": "14px",
          "blur": "24px",
          "spread": "-10px"
        }
      ],
      "$description": "Raised surfaces that respond to the pointer (a card that is a link). Same position, a stronger ring and deeper shadow: the surface doesn't move."
    },
    "sheen": {
      "$value": [
        {
          "color": "#ffffff40",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        },
        {
          "color": "#0000001a",
          "offsetX": "0px",
          "offsetY": "-1px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        }
      ],
      "$description": "Rim light and base shade inside a solid fill (primary, danger button): the edge catches light, so the fill reads as a physical key. Add a colored drop shadow beside it."
    },
    "control": {
      "$value": [
        {
          "color": "#0000000f",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px"
        },
        {
          "color": "#0000000a",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        }
      ],
      "$description": "Resting shadow for bordered controls: secondary button, segmented control, select trigger. Pair with border.default."
    },
    "inset": {
      "$value": [
        {
          "color": "#0000000d",
          "offsetX": "0px",
          "offsetY": "1px",
          "blur": "2px",
          "spread": "0px",
          "inset": true
        }
      ],
      "$description": "A faint inner shadow in the top edge of text inputs, so the field reads as a recess."
    }
  }
}
