        },
        "text": {
          "$value": "#e6dcff"
        }
      },
      "3": {
        "subtle": {
          "$value": "#14473a"
        },
        "text": {
          "$value": "#c6f3e1"
        }
      },
      "4": {
        "subtle": {
          "$value": "#3b4a14"
        },
        "text": {
          "$value": "#e3f5b8"
        }
      },
      "5": {
        "subtle": {
          "$value": "#5a4310"
