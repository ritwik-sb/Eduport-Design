      },
      "subtle": {
        "$value": "#261810"
      },
      "inverse": {
        "$value": "#fff3ea"
      },
      "scrim": {
        "$value": "#000000b8"
      }
    },
    "surface": {
      "default": {
        "$value": "#1c110a"
      },
      "sheet": {
        "$value": "#1c110a"
      },
      "raised": {
        "$value": "#2e1d13"
      },
      "overlay": {
        "$value": "#2e1d13"
      },
      "sunken": {
        "$value": "#170d07"
      },
