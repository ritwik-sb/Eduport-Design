    "interactive": {
      "secondary": {
        "hover": {
          "$value": "#2e1d13"
        },
        "active": {
          "$value": "#3a261a"
        }
      },
      "ghost": {
        "hover": {
          "$value": "#2e1d13"
        },
        "active": {
          "$value": "#3a261a"
        }
      },
      "disabled": {
        "$value": "#34241a"
      }
    },
    "rail": {
      "background": {
        "$value": "#2a1a10"
      },
      "text-secondary": {
        "$value": "#d9bfae"
      }
    }
  },
  "shadow": {
    "$type": "shadow",
    "raised": {
      "$value": [
        {
          "color": "#7a5842",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "2px"
        },
        {
          "color": "#7a5842",
          "offsetX": "0px",
          "offsetY": "5px",
          "blur": "0px",
          "spread": "2px"
        }
      ],
      "$description": "Playground: a 2px outline with a hard 5px base, so a card reads as a sticker. Works without a border."
    },
    "raised-hover": {
      "$value": [
        {
          "color": "#7a5842",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "2px"
        },
        {
          "color": "#7a5842",
          "offsetX": "0px",
          "offsetY": "5px",
          "blur": "0px",
          "spread": "2px"
        }
      ]
    },
    "overlay": {
      "$value": [
        {
          "color": "#7a5842",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "2px"
        },
        {
          "color": "#7a5842",
          "offsetX": "0px",
          "offsetY": "6px",
          "blur": "0px",
          "spread": "2px"
        },
        {
          "color": "#00000066",
          "offsetX": "0px",
          "offsetY": "16px",
          "blur": "32px",
          "spread": "-12px"
        }
      ]
    },
    "sheen": {
      "$value": [
        {
          "color": "#00000000",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        }
      ]
    },
    "control": {
      "$value": [
        {
          "color": "#00000000",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        }
      ]
    },
    "inset": {
      "$value": [
        {
          "color": "#00000000",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px",
          "inset": true
        }
      ]
    },
    "sheet": {
      "$value": [
        {
          "color": "#00000000",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
          "spread": "0px"
        }
      ],
      "$description": "The content sheet blends into the canvas, so it carries no outline."
    },
    "toned": {
      "$value": [
        {
          "color": "#7a5842",
          "offsetX": "0px",
          "offsetY": "0px",
          "blur": "0px",
