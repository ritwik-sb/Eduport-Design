{
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans": {
        "$value": [
          "Nunito Variable",
          "Nunito",
          "Inter Variable",
          "Inter",
          "Noto Sans Malayalam Variable",
          "Noto Sans Malayalam",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "Playground: Nunito, self-hosted by the app (e.g. @fontsource-variable/nunito). Rounded terminals and heavy weights are most of the style. Malayalam falls through to Noto Sans Malayalam."
      },
      "display": {
        "$value": [
          "Nunito Variable",
          "Nunito",
          "Inter Variable",
          "Inter",
          "Noto Sans Malayalam Variable",
          "Noto Sans Malayalam",
          "system-ui",
          "-apple-system",
          "Segoe UI",
          "Roboto",
          "Helvetica Neue",
          "Arial",
          "sans-serif"
        ],
        "$description": "Playground headings use the same Nunito at black weight."
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 500
      },
      "medium": {
        "$value": 600
      },
      "semibold": {
        "$value": 800
      },
      "bold": {
        "$value": 900
      }
    }
  },
  "border-width": {
    "$type": "dimension",
    "thin": {
      "$value": "2px"
    },
    "thick": {
      "$value": "3px"
    }
  },
  "effect": {
    "depth-control": {
      "$type": "dimension",
      "$value": "4px"
    },
    "glow-strength": {
      "$type": "number",
      "$value": 0
    },
    "sheen-strength": {
      "$type": "number",
      "$value": 0
    },
    "tone-fill": {
      "$type": "number",
      "$value": 1
    }
  },
  "motion": {
    "distance": {
      "$type": "dimension",
      "press": {
        "$value": "4px"
      }
    },
    "scale": {
      "press": {
        "$type": "number",
        "$value": 1
      }
    }
  }
}
